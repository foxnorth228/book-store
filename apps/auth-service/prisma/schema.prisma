generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma"

  runtime = "nodejs"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String   @id @default(uuid())

  email        String   @unique
  passwordHash String
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}