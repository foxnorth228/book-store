{
  "name": "@org/auth-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma --config=./prisma.config.ts"
  },
  "dependencies": {
    "@fastify/autoload": "catalog:fastify",
    "@fastify/cookie": "catalog:fastify",
    "@fastify/jwt": "catalog:fastify",
    "@fastify/sensible": "catalog:fastify",
    "@fastify/swagger": "catalog:fastify",
    "@fastify/swagger-ui": "catalog:fastify",
    "@grpc/grpc-js": "catalog:back",
    "@org/contracts": "workspace:*",
    "@org/errors": "workspace:*",
    "@org/fastify": "workspace:*",
    "@org/fastify-plugins": "workspace:*",
    "@org/grpc": "workspace:*",
    "@org/localization": "workspace:*",
    "@org/rabbitmq": "workspace:*",
    "@org/shared": "workspace:*",
    "@prisma/adapter-pg": "catalog:back",
    "@prisma/client": "catalog:back",
    "fastify": "catalog:fastify",
    "fastify-plugin": "catalog:fastify",
    "ms": "catalog:",
    "pg": "catalog:back",
    "pino": "catalog:fastify",
    "redis": "catalog:back",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:back",
    "prisma": "catalog:back"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/auth-service/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/auth-service/src/server.ts",
          "tsConfig": "apps/auth-service/tsconfig.app.json",
          "assets": [
            "apps/auth-service/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/package.json",
          "{workspaceRoot}/apps/auth-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/auth-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "generate-pnpm-workspace": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node infrastructure/scripts/generate-docker-pnpm-workspace.mjs apps/auth-service/dist"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "generate-pnpm-workspace"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/auth-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/auth-service:build:development"
          },
          "production": {
            "buildTarget": "@org/auth-service:build:production"
          }
        }
      },
      "docker:build": {
        "command": "docker build apps/auth-service --tag apps-auth-service",
        "dependsOn": [
          "build",
          "prune",
          "generate-pnpm-workspace"
        ]
      },
      "docker:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker run --name apps-auth-service -p 3001:3001 --env-file {projectRoot}/.env apps-auth-service"
        }
      },
      "global:prisma:generate": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "prisma generate --schema=apps/auth-service/prisma/schema.prisma"
        }
      },
      "global:prisma:migrate:dev": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "prisma migrate dev --schema=apps/auth-service/prisma/schema.prisma --config=apps/auth-service/prisma.config.ts"
        }
      },
      "global:prisma:migrate:reset": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "prisma migrate reset --schema=apps/auth-service/prisma/schema.prisma --config=apps/auth-service/prisma.config.ts --force"
        }
      }
    }
  }
}
