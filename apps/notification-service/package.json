{
  "name": "@org/notification-service",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@fastify/autoload": "catalog:",
    "@fastify/sensible": "catalog:",
    "@org/contracts": "workspace:*",
    "@org/fastify": "workspace:*",
    "@org/fastify-plugins": "workspace:*",
    "@org/rabbitmq": "workspace:*",
    "@org/shared": "workspace:*",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "handlebars": "catalog:notification-service",
    "mjml": "catalog:notification-service",
    "nodemailer": "catalog:notification-service",
    "pino": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/notification-service/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/notification-service/src/server.ts",
          "tsConfig": "apps/notification-service/tsconfig.app.json",
          "assets": [
            "apps/notification-service/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/notification-service/dist/package.json",
          "{workspaceRoot}/apps/notification-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/notification-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/notification-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/notification-service:build:development"
          },
          "production": {
            "buildTarget": "@org/notification-service:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      }
    }
  }
}
