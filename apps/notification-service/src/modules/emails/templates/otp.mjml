<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif" />
      <mj-text color="#1f2937" font-size="16px" line-height="24px" />
    </mj-attributes>

    <mj-style>
      .otp-code {
        letter-spacing: 8px;
        font-weight: 700;
        font-size: 32px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f4f5">
    <mj-section padding="40px 20px">
      <mj-column background-color="#ffffff" border-radius="12px" padding="32px">
        <mj-text align="center" font-size="24px" font-weight="700">
          {{ title }}
        </mj-text>

        <mj-text align="center">
          {{ description }}
        </mj-text>

        <mj-spacer height="16px" />

        <mj-text
          align="center"
          css-class="otp-code"
          font-size="32px"
          font-weight="700"
          letter-spacing="8px"
        >
          {{ otpCode }}
        </mj-text>

        <mj-spacer height="16px" />

        <mj-text align="center" color="#71717a" font-size="14px">
          {{ expiration }}
        </mj-text>

        <mj-divider border-color="#e4e4e7" margin="24px 0" />

        <mj-text align="center" color="#71717a" font-size="13px">
          {{ ignoreMessage }}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
