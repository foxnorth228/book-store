{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["eslint.config.js", "eslint.config.cjs", "eslint.config.mjs"],
  "references": [
    {
      "path": "../../packages/shared/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rabbitmq/tsconfig.lib.json"
    },
    {
      "path": "../../packages/fastify-plugins/tsconfig.lib.json"
    },
    {
      "path": "../../packages/fastify/tsconfig.lib.json"
    },
    {
      "path": "../../packages/contracts/tsconfig.lib.json"
    }
  ]
}
