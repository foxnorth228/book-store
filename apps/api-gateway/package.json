{
  "name": "@org/api-gateway",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@fastify/autoload": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/sensible": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@fastify/http-proxy": "catalog:",
    "@org/fastify": "workspace:*",
    "@org/fastify-plugins": "workspace:*",
    "@org/shared": "workspace:*",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "nx": {
    "name": "api-gateway",
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/api-gateway/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/api-gateway/src/server.ts",
          "tsConfig": "apps/api-gateway/tsconfig.app.json",
          "assets": [
            "apps/api-gateway/src/assets"
          ],
          "generatePackageJson": true,
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api-gateway/dist/package.json",
          "{workspaceRoot}/apps/api-gateway/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api-gateway/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "generate-pnpm-workspace": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node infrastructure/scripts/generate-docker-pnpm-workspace.mjs {projectRoot}/dist"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "generate-pnpm-workspace"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api-gateway:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api-gateway:build:development"
          },
          "production": {
            "buildTarget": "api-gateway:build:production"
          }
        }
      },
      "docker:build": {
        "command": "docker build apps/api-gateway --tag apps-api-gateway",
        "dependsOn": [
          "build",
          "prune",
          "generate-pnpm-workspace"
        ]
      },
      "docker:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "docker run --name apps-api-gateway -p 3000:3000 --env-file {projectRoot}/.env apps-api-gateway"
        }
      }
    }
  }
}
