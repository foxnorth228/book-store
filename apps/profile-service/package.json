{
  "name": "@org/profile-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/profile-service/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "apps/profile-service/src/main.ts",
          "tsConfig": "apps/profile-service/tsconfig.app.json",
          "assets": [
            "apps/profile-service/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "generateLockfile": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/profile-service/dist/package.json",
          "{workspaceRoot}/apps/profile-service/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/profile-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "generate-pnpm-workspace": {
        "dependsOn": [
          "prune"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node infrastructure/scripts/generate-docker-pnpm-workspace.mjs apps/profile-service/dist"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@org/profile-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@org/profile-service:build:development"
          },
          "production": {
            "buildTarget": "@org/profile-service:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune",
          "generate-pnpm-workspace"
        ]
      }
    }
  },
  "scripts": {
    "install:shared": "cd workspace_modules/@org/shared && pnpm install"
  },
  "dependencies": {
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "@fastify/autoload": "catalog:",
    "@fastify/sensible": "catalog:",
    "@org/shared": "workspace:*"
  }
}
