generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma/client"
  
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @default(uuid())

  email     String?  @unique
  password  String?

  region    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}