generator client {
  provider = "prisma-client"
  output   = "../src/libs/prisma"
  
  runtime = "nodejs"
  moduleFormat = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String   @unique

  firstName  String?
  surname    String?
  nickname   String
}