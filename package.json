  "private": true,
  "license": "MIT",
  "scripts": {
    "compose:dev:build": "pnpm compose:dev:prepare && docker compose -f infrastructure/docker-compose/docker-compose.dev.yaml --env-file infrastructure/docker-compose/.env.development build --no-cache",
    "compose:dev:down": "docker compose -f infrastructure/docker-compose/docker-compose.dev.yaml --env-file infrastructure/docker-compose/.env.development down",
    "compose:dev:prepare": "pnpm pgadmin:build && pnpm compose:prod:prepare",
    "compose:dev:up": "docker compose -f infrastructure/docker-compose/docker-compose.dev.yaml --env-file infrastructure/docker-compose/.env.development up",
    "compose:prod:build": "pnpm compose:prod:prepare && docker compose -f infrastructure/docker-compose/docker-compose.prod.yaml --env-file infrastructure/docker-compose/.env.production build --no-cache",
    "compose:prod:down": "docker compose -f infrastructure/docker-compose/docker-compose.prod.yaml --env-file infrastructure/docker-compose/.env.production down",
    "compose:prod:prepare": "pnpm i && pnpm web:build && nx prune profile-service && nx prune auth-service && nx prune catalog-service && nx prune notification-service",
    "compose:prod:ps": "docker compose -f infrastructure/docker-compose/docker-compose.prod.yaml --env-file infrastructure/docker-compose/.env.production ps",
    "compose:prod:up": "docker compose -f infrastructure/docker-compose/docker-compose.prod.yaml --env-file infrastructure/docker-compose/.env.production up",
    "infra:down": "docker stop rift-hub-mailpit rift-hub-redis rift-hub-rabbitmq rift-hub-postgres",
    "infra:remove": "docker container remove rift-hub-mailpit rift-hub-redis rift-hub-rabbitmq rift-hub-postgres",
    "infra:up": "pnpm postgres:up && pnpm rabbitmq:up && pnpm redis:up && pnpm mailpit:up",
    "mailpit:up": "bash infrastructure/mailpit/run.sh",
    "pgadmin:build": "bash infrastructure/pgadmin/entrypoint.sh",
    "postgres:up": "bash infrastructure/postgres/run.sh",
    "prepare": "husky",
    "rabbitmq:up": "bash infrastructure/rabbitmq/run.sh",
    "redis:up": "bash infrastructure/redis/run.sh",
    "web:build": "nx build web"
  },
