{
  "$schema": "https://json-schema.org/schema",
  "$id": "ModuleGenerator",
  "title": "Backend Module Generator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Module name",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "project": {
      "type": "string",
      "description": "Target service project"
    }
  },
  "required": ["name", "project"]
}
